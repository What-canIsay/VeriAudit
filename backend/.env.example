# VeriAudit 后端【满血配置】示例 —— 复制为 .env 即可让系统在最大能力下运行。
# 本文件已把所有能力开关显式打开（含默认关闭的重型 CodeQL 扫描 ENABLE_CODEQL），
# 并关闭 agentic 名额限制（不限名额=每个候选都深度核验）。所有变量前缀 VERIAUDIT_。
# 此处未显式列出/仍注释的项都用内置默认值（多为数值下限，规模自适应会自动放大）。
#
# ⚠️ 要真正满血，还需三件事：
#  1)【必填】填入真实 LLM_API_KEY —— 留空=Mock 离线模式（确定性规则，非满血）。
#  2) 装齐外部工具，否则对应能力会【自动降级并在前端弹提示】（不影响其余功能）：
#     · docker           —— 动态复现 / 环境搭建 / 实弹核验
#     · codeql CLI       —— 语义扫描(codeql_scan) + python/js/ts 调用图与污点
#     · joern-cli + JDK17+ —— php/go/java/ruby/c# 等多语言调用图（默认自动探测 D:/Tools）
#     · semgrep / gitleaks / osv-scanner —— 广度 SAST / 密钥 / 依赖 CVE
#     · 按待审语言的运行时：php、node、go（Joern 前端 / 动态搭建需要）
#  3) 审计时选 depth=deep —— 才会触发环境搭建 + 核验预热 + 验证官 agentic 实弹复现（满血审计深度）。

# ============================ 存储 ============================
# 默认 SQLite（零配置）；大项目/高并发可换 Postgres
# VERIAUDIT_DATABASE_URL=sqlite:///./_data/veriaudit.db
# VERIAUDIT_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/veriaudit

# ============================ 跨域 ============================
# VERIAUDIT_CORS_ORIGINS=*

# ======================= LLM 网关（LiteLLM）=======================
# 【必填·满血前提】留空=Mock 离线模式（非满血）。填入真实 Key=云端强模型满血。
VERIAUDIT_LLM_API_KEY=
# VERIAUDIT_LLM_API_BASE=                    # 可选：自建/中转 base url

# provider 与模型字符串必须匹配。当前用 DeepSeek（强档=v4-pro）。换 Anthropic 见下方。
VERIAUDIT_LLM_PROVIDER=deepseek
VERIAUDIT_MODEL_STRONG=deepseek-v4-pro       # hunter / tracer / validator（推理核心）
VERIAUDIT_MODEL_MID=deepseek-v4-pro          # planner / provisioner
VERIAUDIT_MODEL_CHEAP=deepseek-v4-flash      # recon / reporter（要绝对最大可也提到 v4-pro）
#  —— 或 Anthropic（provider 与模型的 config 默认族）——
# VERIAUDIT_LLM_PROVIDER=anthropic
# VERIAUDIT_MODEL_STRONG=claude-opus-4-8
# VERIAUDIT_MODEL_MID=claude-opus-4-8
# VERIAUDIT_MODEL_CHEAP=claude-haiku-4-5

# LLM 请求超时与重试（自适应下限，防挂起）
# VERIAUDIT_LLM_TIMEOUT_SEC=90
# VERIAUDIT_LLM_NUM_RETRIES=1

# ==================== 预算护栏（规模自适应）====================
# 满血：开启自适应预算——审计前由 profiler 按项目规模/复杂度把下面各上限从"下限"放大到内置上限。
VERIAUDIT_ENABLE_ADAPTIVE_BUDGET=true
# 下面是小项目的下限（大项目自动放大，一般无需改）：
# VERIAUDIT_LLM_HUNT_STEPS=16                # 挖掘阶段最大工具步数（下限）
# VERIAUDIT_LLM_TRIAGE_LIMIT=16              # 单轮判定/语义污点的候选上限（下限）
# VERIAUDIT_MAX_CANDIDATES=60                # 每任务候选上限（下限）
# VERIAUDIT_MAX_VERIFY=30                    # 每任务验证上限（下限）
# VERIAUDIT_MAX_AGENT_STEPS=12              # 通用 per-agent 循环上限
# VERIAUDIT_TASK_TIMEOUT_SEC=1800            # 单任务总超时（下限；自动放大覆盖各阶段）

# ==================== 深度核验（验证官 agentic）====================
VERIAUDIT_ENABLE_AGENTIC_VERIFY=true         # 验证官读全上下文 + 沙箱实弹复现（deep + 已搭建环境）
VERIAUDIT_VALIDATOR_AGENTIC_FIRST=true       # agentic 优先（失败回落旧逻辑）
VERIAUDIT_ENABLE_AGENTIC_VERIFY_LIMIT=false  # 满血：不限名额——每个符合条件候选都深度核验（最彻底，最耗 token）
# VERIAUDIT_AGENTIC_VERIFY_LIMIT=3           # 名额上限（仅当上面=true 时生效）
# 每候选步数 = 基准B + 附加(位次/漏洞类别/是否鉴权/污点深度)，接近复现成功可 1.5x 续步
# VERIAUDIT_VALIDATOR_STEPS=12               # 基准步数 B（下限）
# VERIAUDIT_VALIDATOR_STEP_ADD_MAX=12        # 附加值封顶
# VERIAUDIT_VALIDATOR_STEP_EXTENSION=1.5     # 一次性续步倍数
# VERIAUDIT_VALIDATOR_STEP_HARD_CAP=40       # 单候选步数绝对硬顶

# ==================== 沙箱（动态 PoC 验证，需 Docker）====================
VERIAUDIT_ENABLE_SANDBOX=true
VERIAUDIT_SANDBOX_ALLOW_NETWORK=true         # 满血：放开网络以便容器装项目依赖；false=严格无出网
# VERIAUDIT_SANDBOX_IMAGE_PREFIX=veriaudit-sandbox
# VERIAUDIT_SANDBOX_TIMEOUT_SEC=60           # 单次利用请求窗口
# VERIAUDIT_SANDBOX_BUILD_TIMEOUT_SEC=420    # 复现容器总超时（含装依赖+启动）

# ==================== 环境构建官（仅 deep 档）====================
VERIAUDIT_ENABLE_PROVISIONER=true            # 一次把目标应用搭起来供复用（python/node/php 有确定性搭建路径，其余转模型自搭）
VERIAUDIT_ENABLE_PROVISIONER_PREHEAT=true    # 核验预热：备好测试账号/角色会话/seed 数据/备忘，让逐候选核验热启动
# VERIAUDIT_PROVISIONER_MAX_STEPS=16         # 搭建步数（下限）
# VERIAUDIT_PROVISIONER_TIMEOUT_SEC=900      # 搭建总时长（下限）
# VERIAUDIT_PROVISIONER_CMD_TIMEOUT_SEC=240  # 单条搭建命令超时（下限；需构建的项目自动放大）
# VERIAUDIT_PREHEAT_MAX_STEPS=14             # 预热步数（下限）
# VERIAUDIT_PROVISIONER_LLM_ENRICH=false     # 已被预热取代，保持关闭

# ==================== 专业扫描器 + 调用图（满血：全开）====================
VERIAUDIT_ENABLE_SEMGREP=true                # 多语言模式 SAST（离线回落 Bandit）
VERIAUDIT_ENABLE_SECRET_SCAN=true            # gitleaks 硬编码密钥检测
VERIAUDIT_ENABLE_DEPENDENCY_SCAN=true        # osv-scanner 依赖已知 CVE
VERIAUDIT_ENABLE_CODEQL=true                 # 满血：开启重型 codeql_scan 语义数据流扫描工具（需装 codeql；较慢吃内存）
# VERIAUDIT_SCANNER_TIMEOUT_SEC=180
# 调用图精度阶梯 CodeQL>Joern>Tree-sitter：用于跨过程可达性(check_reachability) + cg_dataflow 污点。
# CodeQL 免构建覆盖 python/javascript/typescript（已验证）；Joern 兜底 php/go/java/ruby/c# 等。
VERIAUDIT_ENABLE_CODEQL_CALLGRAPH=true
VERIAUDIT_ENABLE_JOERN_CALLGRAPH=true
# VERIAUDIT_CODEQL_RAM_MB=1400               # CodeQL 内存上限（OOM 时降级）
# VERIAUDIT_CODEQL_TIMEOUT_SEC=300           # 每步 CodeQL 超时（建库/查询）
# VERIAUDIT_JOERN_DIR=                        # joern-cli 目录（留空自动探测 D:/Tools/joern-cli）
# VERIAUDIT_JOERN_JAVA_HOME=                  # JDK17+ 路径（留空自动探测 D:/Tools 下 JDK）
# VERIAUDIT_JOERN_TIMEOUT_SEC=420

# ==================== RAG 语义检索（满血：开）====================
# 两处用到语义检索：① search_code_semantic 对全项目代码建向量索引(按文件 hash 增量)，猎手/验证官
# 用自然语言定位同类危险模式/净化函数/入口(索引在侦察阶段建，仅云端模型模式)；② search_vuln_kb
# 对内置漏洞知识库做【语义+关键词混合】检索。二者都只作"线索/导航"，定案一律以 read_file 精确阅读为准。
# 【总开关】设 false = 全面关闭 RAG：search_code_semantic 在猎手/验证官/预热处均隐藏、不建索引、
# 知识库检索回落纯关键词(search_vuln_kb 仍可用)。
VERIAUDIT_ENABLE_RAG=true
# 嵌入后端阶梯：auto=有 fastembed 走真语义(离线 ONNX)否则回落词法 hashing；也可 fastembed/cloud/hashing
VERIAUDIT_RAG_EMBED_BACKEND=auto
# fastembed 模型（首次用会下载到 D 盘缓存，之后全离线）；cloud 模式下作为云端嵌入模型名
# VERIAUDIT_RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# VERIAUDIT_RAG_FASTEMBED_CACHE=D:/Tools/fastembed_cache   # 模型缓存放 D 盘
# VERIAUDIT_RAG_EMBED_BATCH=8                 # 嵌入批大小；越小越省内存(≈batch×100MB)。内存紧张的 deep 审计下
#                                             # fastembed 若仍 OOM 会自动回落词法 hashing（审计不会失败），可调更小
# VERIAUDIT_RAG_TOP_K=8                        # 每次检索返回条数
# VERIAUDIT_RAG_HYBRID_ALPHA=0.7              # 语义 vs 词法在混合重排中的权重
# VERIAUDIT_RAG_MAX_CHUNK_LINES=120           # 代码块最大行数（超出按窗口切分）
# VERIAUDIT_RAG_CHUNK_OVERLAP=15              # 窗口切分重叠行数
# VERIAUDIT_RAG_HASHING_DIM=512               # 词法回落向量维度
