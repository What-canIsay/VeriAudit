# VeriAudit 后端配置示例 —— 复制为 .env 后按需修改（所有变量前缀 VERIAUDIT_）
# 未列出的项都有内置默认值；此处注释掉的行展示的就是默认值，取消注释即可覆盖。

# ============================ 存储 ============================
# 默认 SQLite（零配置）；可改为 Postgres
# VERIAUDIT_DATABASE_URL=sqlite:///./_data/veriaudit.db
# VERIAUDIT_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/veriaudit

# ============================ 跨域 ============================
# VERIAUDIT_CORS_ORIGINS=*

# ======================= LLM 网关（LiteLLM）=======================
# 不填 API Key => Mock 模式（全流程离线可跑，产出确定性证据链）
# 填入 Key    => 云端强模型模式（智能体用 LLM 做语义发现、独立核验、实弹复现）
VERIAUDIT_LLM_API_KEY=
# VERIAUDIT_LLM_API_BASE=                 # 可选：自建/中转 base url

# provider 与下面的模型字符串必须匹配。两个可用示例：
#  —— Anthropic ——                        # provider 与模型的 config 默认值
# VERIAUDIT_LLM_PROVIDER=anthropic
# VERIAUDIT_MODEL_STRONG=claude-opus-4-8  # hunter / tracer / validator（推理核心）
# VERIAUDIT_MODEL_MID=claude-opus-4-8     # planner / provisioner
# VERIAUDIT_MODEL_CHEAP=claude-haiku-4-5  # recon / reporter
#  —— DeepSeek ——
VERIAUDIT_LLM_PROVIDER=deepseek
VERIAUDIT_MODEL_STRONG=deepseek-v4-pro
VERIAUDIT_MODEL_MID=deepseek-v4-pro
VERIAUDIT_MODEL_CHEAP=deepseek-v4-flash

# LLM 请求超时与重试（自适应下限，防挂起）
# VERIAUDIT_LLM_TIMEOUT_SEC=90
# VERIAUDIT_LLM_NUM_RETRIES=1

# ==================== 预算护栏（规模自适应）====================
# 开启后，审计前由 profiler 评估项目规模/复杂度，把下面各上限从"下限"放大到内置上限。
# VERIAUDIT_ENABLE_ADAPTIVE_BUDGET=true
# VERIAUDIT_LLM_HUNT_STEPS=16             # 挖掘阶段最大工具步数（下限）
# VERIAUDIT_LLM_TRIAGE_LIMIT=16           # 单轮判定的候选上限（下限）
# VERIAUDIT_MAX_CANDIDATES=60             # 每任务候选上限（下限）
# VERIAUDIT_MAX_VERIFY=30                 # 每任务验证上限（下限）
# VERIAUDIT_MAX_AGENT_STEPS=12            # 通用 per-agent 循环上限
# VERIAUDIT_TASK_TIMEOUT_SEC=1800         # 单任务总超时（下限；自动放大覆盖各阶段）

# ==================== 深度核验（验证官 agentic）====================
# VERIAUDIT_ENABLE_AGENTIC_VERIFY=true    # 验证官读全上下文 + 沙箱实弹复现（deep + 已搭建环境）
# VERIAUDIT_VALIDATOR_AGENTIC_FIRST=true  # true=agentic 优先(失败回落旧逻辑)；false=旧逻辑优先(仅高危升级)
# VERIAUDIT_ENABLE_AGENTIC_VERIFY_LIMIT=false  # false=不限名额(每个符合条件候选都深度核验，更彻底更耗token)
# VERIAUDIT_AGENTIC_VERIFY_LIMIT=3        # 名额上限（仅当上面=true 时生效）
# 每候选步数 = 基准B + 附加(位次/漏洞类别/是否鉴权/污点深度)
# VERIAUDIT_VALIDATOR_STEPS=12            # 基准步数 B（下限）
# VERIAUDIT_VALIDATOR_STEP_ADD_MAX=12     # 附加值封顶
# VERIAUDIT_VALIDATOR_STEP_EXTENSION=1.5  # 接近复现成功却将耗尽时的一次性续步倍数
# VERIAUDIT_VALIDATOR_STEP_HARD_CAP=40    # 单候选步数绝对硬顶

# ==================== 沙箱（动态 PoC 验证，需 Docker）====================
# VERIAUDIT_ENABLE_SANDBOX=true
# VERIAUDIT_SANDBOX_IMAGE_PREFIX=veriaudit-sandbox
# VERIAUDIT_SANDBOX_TIMEOUT_SEC=60        # 单次利用请求窗口
# VERIAUDIT_SANDBOX_BUILD_TIMEOUT_SEC=420 # 复现容器总超时（含装依赖+启动）
# VERIAUDIT_SANDBOX_ALLOW_NETWORK=true    # 复现容器放开网络（仅用于装项目依赖）；false=严格无出网

# ==================== 环境构建官（仅 deep 档）====================
# VERIAUDIT_ENABLE_PROVISIONER=true       # 一次把目标应用搭起来供复用
# VERIAUDIT_PROVISIONER_MAX_STEPS=16      # 搭建步数（下限）
# VERIAUDIT_PROVISIONER_TIMEOUT_SEC=900   # 搭建总时长（下限）
# VERIAUDIT_PROVISIONER_CMD_TIMEOUT_SEC=240  # 单条搭建命令超时（下限）
# 核验预热：应用起来后按项目自适应地准备测试账号/角色会话/seed 数据/备忘，让逐候选核验热启动
# VERIAUDIT_ENABLE_PROVISIONER_PREHEAT=true
# VERIAUDIT_PREHEAT_MAX_STEPS=14          # 预热步数（下限）
# VERIAUDIT_PROVISIONER_LLM_ENRICH=false  # 已被预热取代，保留仅作兼容/关闭用

# ==================== 专业扫描器（缺失自动降级）====================
# VERIAUDIT_ENABLE_SEMGREP=true           # 多语言模式 SAST（离线回落 Bandit）
# VERIAUDIT_ENABLE_CODEQL=false           # codeql_scan 语义数据流扫描（重，需安装 codeql）
# 调用图精度阶梯：用 CodeQL 精化跨过程调用边（可达性 + call_path + 污点数据流），
# 免构建语言(python / javascript / typescript，均已验证)自动启用；TS 复用 js 提取器、不需要 node。
# 失败/超时/OOM 自动降级到 Joern/Tree-sitter。CodeQL 吃内存(~1.4GB)，机器紧张可关。
# VERIAUDIT_ENABLE_CODEQL_CALLGRAPH=true
# VERIAUDIT_CODEQL_RAM_MB=1400
# VERIAUDIT_CODEQL_TIMEOUT_SEC=300
# Joern：多语言(含 PHP/Go/Java/Ruby/C#，免构建)调用图，位于 CodeQL 之下、兜底 CodeQL 未覆盖的语言。
# 需 joern-cli + JDK17+ (默认自动探测 D:/Tools 下的 joern-cli 与 jdk；php/go 前端还需对应 php/go 可执行)。
# VERIAUDIT_ENABLE_JOERN_CALLGRAPH=true
# VERIAUDIT_JOERN_DIR=                     # joern-cli 目录（留空自动探测）
# VERIAUDIT_JOERN_JAVA_HOME=               # JDK17+ 路径（留空自动探测）
# VERIAUDIT_JOERN_TIMEOUT_SEC=420
# VERIAUDIT_ENABLE_SECRET_SCAN=true       # gitleaks 密钥检测
# VERIAUDIT_ENABLE_DEPENDENCY_SCAN=true   # osv-scanner 依赖 CVE
# VERIAUDIT_SCANNER_TIMEOUT_SEC=180
