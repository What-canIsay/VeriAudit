# VeriAudit 后端配置示例 —— 复制为 .env 后按需修改（所有变量前缀 VERIAUDIT_）

# ---- 数据库（默认 SQLite，零配置；可改为 Postgres）----
# VERIAUDIT_DATABASE_URL=sqlite:///./_data/veriaudit.db
# VERIAUDIT_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/veriaudit

# ---- LLM 网关（LiteLLM）----
# 不填 API Key => Mock 模型模式（全流程离线可跑，产出确定性证据链）
# 填入 Key    => 云端强模型模式（智能体用 LLM 做语义发现与独立验证）
VERIAUDIT_LLM_PROVIDER=deepseek
VERIAUDIT_LLM_API_KEY=
# VERIAUDIT_LLM_API_BASE=            # 可选：自建/中转 base url

# 模型分级（LiteLLM 模型字符串；按厂商约定，如 anthropic/claude-opus-4-8、gpt-4o、deepseek/deepseek-chat）
VERIAUDIT_MODEL_STRONG=deepseek-v4-pro    # hunter / tracer / validator（推理核心）
VERIAUDIT_MODEL_MID=deepseek-v4-pro       # planner
VERIAUDIT_MODEL_CHEAP=deepseek-v4-flash    # recon / reporter

# ---- 预算护栏 ----
VERIAUDIT_MAX_AGENT_STEPS=12
VERIAUDIT_MAX_CANDIDATES=40
VERIAUDIT_MAX_VERIFY=20
VERIAUDIT_TASK_TIMEOUT_SEC=1800

# ---- 沙箱（动态 PoC 验证，需要 Docker）----
VERIAUDIT_ENABLE_SANDBOX=true
VERIAUDIT_SANDBOX_TIMEOUT_SEC=60

# ---- 外部扫描器（可选，缺失则自动降级）----
VERIAUDIT_ENABLE_SEMGREP=true

# ---- 跨域 ----
VERIAUDIT_CORS_ORIGINS=*
